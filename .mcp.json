{
  "mcpServers": {
    "cadmcp": {
      "type": "stdio",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/start-cadmcp.ps1"
      ],
      "env": {}
    },
    "hostmcp": {
      "type": "stdio",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "scripts/start-hostmcp.ps1"
      ],
      "env": {}
    }
  }
}
