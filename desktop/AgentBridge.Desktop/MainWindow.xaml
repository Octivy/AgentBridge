<Window x:Class="AgentBridge.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="AgentBridge 桥接控制台"
        Width="1280" Height="800"
        MinWidth="960" MinHeight="600"
        Background="{StaticResource BgMain}"
        WindowStartupLocation="CenterScreen"
        Closing="Window_Closing"
        StateChanged="Window_StateChanged">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <!-- Main: sidebar + content -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="210" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderLine}" BorderThickness="0,0,1,0">
                <DockPanel Margin="12">
                    <StackPanel DockPanel.Dock="Top" Margin="4,0,4,18">
                        <TextBlock Text="AgentBridge" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                        <TextBlock Text="Agent ⇄ 软件桥接控制台" FontSize="12" Foreground="{StaticResource TextSecondary}" Margin="0,3,0,0" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="4,12,4,4">
                        <Button x:Name="BtnRestartBackend" Content="重启后端" Style="{StaticResource SidebarButtonStyle}"
                                Click="BtnRestartBackend_Click" />
                        <Button x:Name="BtnOpenExternal" Content="在浏览器中打开面板" Style="{StaticResource SidebarButtonStyle}"
                                Click="BtnOpenExternal_Click" Margin="0,8,0,0" />
                    </StackPanel>

                    <StackPanel>
                        <RadioButton x:Name="NavOverview" Content="总览" GroupName="nav" IsChecked="True"
                                     Style="{StaticResource NavRadioStyle}" Checked="Nav_Checked" Tag="overview" />
                        <RadioButton x:Name="NavSoftware" Content="软件配置" GroupName="nav"
                                     Style="{StaticResource NavRadioStyle}" Checked="Nav_Checked" Tag="software" />
                        <RadioButton x:Name="NavMonitor" Content="连接监控" GroupName="nav"
                                     Style="{StaticResource NavRadioStyle}" Checked="Nav_Checked" Tag="monitor" />
                        <RadioButton x:Name="NavAgents" Content="Agent 接入" GroupName="nav"
                                     Style="{StaticResource NavRadioStyle}" Checked="Nav_Checked" Tag="agents" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Web content: config center UI -->
            <Grid Grid.Column="1">
                <wv2:WebView2 x:Name="Browser" />
            </Grid>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="1" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderLine}" BorderThickness="0,1,0,0">
            <DockPanel Margin="12,0">
                <Ellipse x:Name="StatusDot" Width="9" Height="9" Fill="{StaticResource Warn}" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" Text="正在启动后端…" Foreground="{StaticResource TextSecondary}"
                           FontSize="12" Margin="8,0,0,0" VerticalAlignment="Center" />
                <TextBlock x:Name="RepoText" Text="" Foreground="{StaticResource TextSecondary}"
                           FontSize="12" HorizontalAlignment="Right" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
